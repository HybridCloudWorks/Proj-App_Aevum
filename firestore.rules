rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        'admin' in request.auth.token &&
        request.auth.token.admin == true;
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId));
    }

    function familyAfter(familyId) {
      return getAfter(/databases/$(database)/documents/families/$(familyId));
    }

    function collaboratorDoc(familyId, userId) {
      return get(/databases/$(database)/documents/families/$(familyId)/collaborators/$(userId));
    }

    function isFamilyOwner(familyId) {
      return isSignedIn() && familyDoc(familyId).data.ownerId == request.auth.uid;
    }

    function canReadFamily(familyId) {
      return isAdmin() ||
        (isSignedIn() && request.auth.uid in familyDoc(familyId).data.collaboratorIds);
    }

    function canWriteFamily(familyId) {
      return isAdmin() ||
        (isSignedIn() &&
          familyDoc(familyId).data.ownerId == request.auth.uid) ||
        (isSignedIn() &&
          collaboratorDoc(familyId, request.auth.uid).data.status == 'active' &&
          collaboratorDoc(familyId, request.auth.uid).data.role == 'editor');
    }

    function protectedProfileKeysAbsent() {
      return !request.resource.data.keys().hasAny([
        'admin',
        'role',
        'roles',
        'claims'
      ]);
    }

    function familyIdentityUnchanged() {
      return request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function collaboratorRoleValid() {
      return request.resource.data.role in ['editor', 'viewer'];
    }

    function collaboratorStatusValid() {
      return request.resource.data.status in ['active', 'invited', 'revoked'];
    }

    function collaboratorMembershipConsistent(familyId, userId) {
      return (
          request.resource.data.status == 'active' &&
          userId in familyAfter(familyId).data.collaboratorIds
        ) || (
          request.resource.data.status != 'active' &&
          !(userId in familyAfter(familyId).data.collaboratorIds)
        );
    }

    function familyScopedIdentityUnchanged() {
      return request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function mediaIdentityUnchanged() {
      return request.resource.data.familyId == resource.data.familyId &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.uploadedBy == resource.data.uploadedBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function mediaReservationValid() {
      return request.resource.data.status == 'uploading' &&
        request.resource.data.aiStatus == 'waiting' &&
        request.resource.data.storage == {};
    }

    function mediaUploadFinalizationValid() {
      return resource.data.status == 'uploading' &&
        request.resource.data.status == 'uploaded' &&
        request.resource.data.aiStatus == resource.data.aiStatus &&
        request.resource.data.storage.diff(resource.data.storage).affectedKeys().hasOnly([
          'originalPath'
        ]) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'photoUrl',
          'thumbnailUrl',
          'storage',
          'imageMetadata',
          'uploadCompletedAt',
          'updatedAt'
        ]);
    }

    function mediaUploadFailureValid() {
      return resource.data.status == 'uploading' &&
        request.resource.data.status == 'upload_failed' &&
        request.resource.data.aiStatus == resource.data.aiStatus &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'uploadError',
          'updatedAt'
        ]);
    }

    function mediaContentUpdateValid() {
      return request.resource.data.status == resource.data.status &&
        request.resource.data.aiStatus == resource.data.aiStatus &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title',
          'description',
          'memberIds',
          'tags',
          'date',
          'albumIds',
          'updatedAt'
        ]);
    }

    function mediaAnalysisRequestValid() {
      return resource.data.status == 'processed' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.aiStatus == 'pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aiStatus',
          'updatedAt'
        ]);
    }

    function mediaRestorationRequestValid() {
      return resource.data.status == 'processed' &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.aiStatus == 'restoration_pending' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'aiStatus',
          'restorationParams',
          'updatedAt'
        ]);
    }

    // -----------------------------------------------------------------------
    // User profiles
    // -----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == userId);

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId &&
        protectedProfileKeysAbsent();

      allow update: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        protectedProfileKeysAbsent();

      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // -----------------------------------------------------------------------
    // Families and authenticated collaborators
    // -----------------------------------------------------------------------
    match /families/{familyId} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid in resource.data.collaboratorIds);

      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.collaboratorIds == [request.auth.uid];

      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == resource.data.ownerId &&
        familyIdentityUnchanged() &&
        resource.data.ownerId in request.resource.data.collaboratorIds
      ) || (
        canWriteFamily(familyId) &&
        request.auth.uid != resource.data.ownerId &&
        familyIdentityUnchanged() &&
        request.resource.data.collaboratorIds == resource.data.collaboratorIds
      );

      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.ownerId);

      match /collaborators/{userId} {
        allow read: if isAdmin() ||
          isFamilyOwner(familyId) ||
          (isSignedIn() && request.auth.uid == userId);

        allow create: if (isAdmin() || isFamilyOwner(familyId)) &&
          request.resource.data.userId == userId &&
          request.resource.data.invitedBy == request.auth.uid &&
          collaboratorRoleValid() &&
          collaboratorStatusValid() &&
          collaboratorMembershipConsistent(familyId, userId);

        allow update: if (isAdmin() || isFamilyOwner(familyId)) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.createdAt == resource.data.createdAt &&
          collaboratorRoleValid() &&
          collaboratorStatusValid() &&
          collaboratorMembershipConsistent(familyId, userId);

        allow delete: if (isAdmin() || isFamilyOwner(familyId)) &&
          !(userId in familyAfter(familyId).data.collaboratorIds);
      }
    }

    // -----------------------------------------------------------------------
    // Genealogical people. These records never grant application access.
    // -----------------------------------------------------------------------
    match /family_members/{personId} {
      allow read: if canReadFamily(resource.data.familyId);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        canWriteFamily(request.resource.data.familyId);

      allow update: if canWriteFamily(resource.data.familyId) &&
        familyScopedIdentityUnchanged();

      allow delete: if canWriteFamily(resource.data.familyId);
    }

    // -----------------------------------------------------------------------
    // Media metadata. Clients reserve/upload/edit/request work; trusted backend
    // processors use Admin SDK/IAM and therefore are not constrained by these
    // client Rules when writing processing/derivative fields.
    // -----------------------------------------------------------------------
    match /media_items/{mediaId} {
      allow read: if canReadFamily(resource.data.familyId);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.uploadedBy == request.auth.uid &&
        canWriteFamily(request.resource.data.familyId) &&
        mediaReservationValid();

      allow update: if canWriteFamily(resource.data.familyId) &&
        mediaIdentityUnchanged() &&
        (
          mediaUploadFinalizationValid() ||
          mediaUploadFailureValid() ||
          mediaContentUpdateValid() ||
          mediaAnalysisRequestValid() ||
          mediaRestorationRequestValid()
        );

      allow delete: if canWriteFamily(resource.data.familyId);
    }

    // -----------------------------------------------------------------------
    // Albums
    // -----------------------------------------------------------------------
    match /albums/{albumId} {
      allow read: if canReadFamily(resource.data.familyId);

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        canWriteFamily(request.resource.data.familyId);

      allow update: if canWriteFamily(resource.data.familyId) &&
        familyScopedIdentityUnchanged();

      allow delete: if canWriteFamily(resource.data.familyId);
    }

    // -----------------------------------------------------------------------
    // User-scoped AI task state. Trusted workers use server credentials/IAM.
    // -----------------------------------------------------------------------
    match /ai_tasks/{taskId} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);

      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn() &&
        request.auth.uid == resource.data.userId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt'
        ]);

      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == resource.data.userId);
    }

    // -----------------------------------------------------------------------
    // Audit stream is backend-written and admin-readable only.
    // -----------------------------------------------------------------------
    match /audit_events/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Explicit deny-by-default for legacy and undeclared collections.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
