rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth check helper
    function isAuthenticated() {
      return request.auth != null;
    }

    // Owner check helper - for documents with a 'userId' field
    function isOwner(resource) {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }
    
    // Owner check for NEW documents (check request.resource)
    function isNewOwner() {
      return isAuthenticated() && request.auth.uid == request.resource.data.userId;
    }

    // --- USERS ---
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // --- MEMBERS (Standardized) ---
    // Since we consolidated to a top-level collection, we check the 'userId' field
    match /members/{memberId} {
      allow read, delete: if isOwner(resource);
      allow create: if isNewOwner();
      allow update: if isOwner(resource) && (request.resource.data.userId == request.auth.uid);
    }

    // --- MEDIA ITEMS ---
    match /media_items/{mediaId} {
      allow read, delete: if isOwner(resource);
      // Ensure 'aiStatus' is only 'pending' or 'restoration_pending' on create, preventing users from forging 'completed' status
      allow create: if isNewOwner() &&
        (!("aiStatus" in request.resource.data) ||
         request.resource.data.aiStatus == "pending" ||
         request.resource.data.aiStatus == "restoration_pending");
      allow update: if isOwner(resource) && (request.resource.data.userId == request.auth.uid) &&
        (!("aiStatus" in request.resource.data) || request.resource.data.aiStatus == resource.data.aiStatus);
    }

    // --- AI TASKS ---
    match /ai_tasks/{taskId} {
      allow read, delete: if isOwner(resource);
      allow create: if isNewOwner();
      allow update: if isOwner(resource) && (request.resource.data.userId == request.auth.uid);
    }

    // --- FAMILIES ---
    match /families/{familyId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid in resource.data.members
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerId;
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;
    }
    
    // Legacy support (subcollections of families if any remain)
    match /families/{familyId}/members/{memberId} {
      allow read, write: if isAuthenticated() && (
        request.auth.uid == get(/databases/$(database)/documents/families/$(familyId)).data.ownerId
      );
    }
  }
}
