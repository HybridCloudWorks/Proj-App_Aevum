rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function familyDoc(familyId) {
      return firestore.get(/databases/(default)/documents/families/$(familyId));
    }

    function collaboratorDoc(familyId) {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/families/$(familyId)/collaborators/$(request.auth.uid))
        : null;
    }

    function canReadFamily(familyId) {
      let family = familyDoc(familyId);
      return isAdmin() ||
        (isSignedIn() &&
          family != null &&
          request.auth.uid in family.data.collaboratorIds);
    }

    function canWriteFamily(familyId) {
      let family = familyDoc(familyId);
      let collaborator = collaboratorDoc(familyId);
      return isAdmin() ||
        (isSignedIn() && family != null && family.data.ownerId == request.auth.uid) ||
        (isSignedIn() &&
          collaborator != null &&
          collaborator.data.status == 'active' &&
          collaborator.data.role == 'editor');
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic)');
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/(mpeg|wav|ogg|mp4|x-m4a)');
    }

    function isDocument() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }

    function imageWithinLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    function videoWithinLimit() {
      return request.resource.size <= 500 * 1024 * 1024;
    }

    function audioWithinLimit() {
      return request.resource.size <= 100 * 1024 * 1024;
    }

    function documentWithinLimit() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    function validFamilyOriginal() {
      return (isImage() && imageWithinLimit()) ||
        (isVideo() && videoWithinLimit()) ||
        (isAudio() && audioWithinLimit()) ||
        (isDocument() && documentWithinLimit());
    }

    // -----------------------------------------------------------------------
    // User profile images
    // -----------------------------------------------------------------------
    match /users/{userId}/profile/{fileName} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
    }

    // -----------------------------------------------------------------------
    // Canonical family media paths
    // -----------------------------------------------------------------------
    match /families/{familyId}/media/{mediaId}/original/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) && validFamilyOriginal();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    match /families/{familyId}/media/{mediaId}/derived/{fileName} {
      allow read: if canReadFamily(familyId);
      // Derived objects are written by trusted backend processors using IAM.
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // Genealogical member photos
    // -----------------------------------------------------------------------
    match /families/{familyId}/members/{personId}/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) &&
        isImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    // -----------------------------------------------------------------------
    // Temporary PR-01 uploader compatibility.
    // Remove these two matches when PR-03 moves uploads to media/{mediaId}/...
    // -----------------------------------------------------------------------
    match /families/{familyId}/memories/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) && validFamilyOriginal();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    match /families/{familyId}/thumbnails/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) &&
        isImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    // -----------------------------------------------------------------------
    // User-owned AI staging area. Trusted workers may use IAM/server SDKs.
    // -----------------------------------------------------------------------
    match /ai-processing/{userId}/{taskId}/{fileName} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
    }

    // -----------------------------------------------------------------------
    // Managed app assets
    // -----------------------------------------------------------------------
    match /public/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
