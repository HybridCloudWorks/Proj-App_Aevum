rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        'admin' in request.auth.token &&
        request.auth.token.admin == true;
    }

    function familyDoc(familyId) {
      return firestore.get(/databases/(default)/documents/families/$(familyId));
    }

    function collaboratorDoc(familyId) {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/families/$(familyId)/collaborators/$(request.auth.uid))
        : null;
    }

    function mediaDoc(mediaId) {
      return firestore.get(/databases/(default)/documents/media_items/$(mediaId));
    }

    function canReadFamily(familyId) {
      let family = familyDoc(familyId);
      return isAdmin() ||
        (isSignedIn() &&
          family != null &&
          request.auth.uid in family.data.collaboratorIds);
    }

    function canWriteFamily(familyId) {
      return isAdmin() ||
        (isSignedIn() &&
          familyDoc(familyId).data.ownerId == request.auth.uid) ||
        (isSignedIn() &&
          collaboratorDoc(familyId).data.status == 'active' &&
          collaboratorDoc(familyId).data.role == 'editor');
    }

    function validMediaReservation(familyId, mediaId) {
      let media = mediaDoc(mediaId);
      return isSignedIn() &&
        media != null &&
        media.data.familyId == familyId &&
        media.data.createdBy == request.auth.uid &&
        media.data.uploadedBy == request.auth.uid &&
        media.data.status == 'uploading';
    }

    function isSupportedImage() {
      return request.resource.contentType.matches('image/(jpeg|png|tiff|webp|heic|heif)');
    }

    function imageWithinLimit() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isSupportedImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
    }

    // Canonical family media paths. Originals require a pre-reserved media
    // document owned by the uploader, are client-created once, and immutable.
    match /families/{familyId}/media/{mediaId}/original/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) &&
        validMediaReservation(familyId, mediaId) &&
        isSupportedImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    // Derivatives may be nested by source generation. Clients can read but not write.
    match /families/{familyId}/media/{mediaId}/derived/{allPaths=**} {
      allow read: if canReadFamily(familyId);
      allow create, update, delete: if false;
    }

    // Genealogical member photos
    match /families/{familyId}/members/{personId}/{fileName} {
      allow read: if canReadFamily(familyId);
      allow create: if canWriteFamily(familyId) &&
        isSupportedImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if canWriteFamily(familyId);
    }

    // User-owned AI staging area. Trusted workers may use IAM/server SDKs.
    match /ai-processing/{userId}/{taskId}/{fileName} {
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        isSupportedImage() &&
        imageWithinLimit();
      allow update: if false;
      allow delete: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId);
    }

    // Managed app assets
    match /public/{allPaths=**} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
