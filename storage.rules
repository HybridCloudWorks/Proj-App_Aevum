rules_version = '2';

/**
 * Aevum Cloud Storage Security Rules
 * 
 * Following GDEF Best Practices:
 * - File type validation
 * - Size limits per file type
 * - User-scoped uploads
 * - Secure public read for shared content
 */

service firebase.storage {
  match /b/{bucket}/o {
    
    // ==========================================
    // Helper Functions
    // ==========================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Validate image file types
    function isValidImageType() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp|heic)');
    }
    
    // Validate video file types
    function isValidVideoType() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }
    
    // Validate audio file types  
    function isValidAudioType() {
      return request.resource.contentType.matches('audio/(mpeg|wav|ogg|m4a)');
    }
    
    // Validate document types
    function isValidDocumentType() {
      return request.resource.contentType.matches('application/(pdf|msword|vnd.openxmlformats-officedocument.wordprocessingml.document)');
    }
    
    // Size limits
    function isUnderImageLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB
    }
    
    function isUnderVideoLimit() {
      return request.resource.size < 500 * 1024 * 1024; // 500MB
    }
    
    function isUnderAudioLimit() {
      return request.resource.size < 100 * 1024 * 1024; // 100MB
    }
    
    function isUnderDocumentLimit() {
      return request.resource.size < 20 * 1024 * 1024; // 20MB
    }

    // ==========================================
    // User Profile Images
    // ==========================================
    match /users/{userId}/profile/{fileName} {
      // Anyone can read profile images
      allow read: if true;
      
      // Only owner can upload/update their profile image
      allow write: if isOwner(userId) &&
                      isValidImageType() &&
                      isUnderImageLimit();
      
      // Owner or admin can delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // Family Shared Media
    // ==========================================
    match /families/{familyId}/media/{allPaths=**} {
      // Authenticated users in the family can read
      // Note: Family membership validation should happen via Cloud Function
      // since Storage rules can't query Firestore
      allow read: if isAuthenticated();
      
      // Authenticated users can upload (Cloud Function validates family membership)
      allow create: if isAuthenticated() &&
                       ((isValidImageType() && isUnderImageLimit()) ||
                        (isValidVideoType() && isUnderVideoLimit()) ||
                        (isValidAudioType() && isUnderAudioLimit()));
      
      // No direct updates - delete and re-upload
      allow update: if false;
      
      // Authenticated users can delete (Cloud Function validates ownership)
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // Memory Attachments
    // ==========================================
    match /memories/{memoryId}/{fileName} {
      // Read access based on memory visibility (checked via Cloud Function)
      allow read: if isAuthenticated();
      
      // Upload with validation
      allow create: if isAuthenticated() &&
                       ((isValidImageType() && isUnderImageLimit()) ||
                        (isValidVideoType() && isUnderVideoLimit()) ||
                        (isValidDocumentType() && isUnderDocumentLimit()));
      
      // No direct updates
      allow update: if false;
      
      // Delete by authenticated users (ownership validated elsewhere)
      allow delete: if isAuthenticated();
    }

    // ==========================================
    // AI Processing Queue
    // ==========================================
    match /ai-processing/{userId}/{taskId}/{fileName} {
      // Only the owner can read their AI processing files
      allow read: if isOwner(userId);
      
      // Owner can upload for processing
      allow create: if isOwner(userId) &&
                       isValidImageType() &&
                       isUnderImageLimit();
      
      // No updates
      allow update: if false;
      
      // Owner or admin can delete
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ==========================================
    // Public Assets (app icons, etc.)
    // ==========================================
    match /public/{allPaths=**} {
      // Anyone can read public assets
      allow read: if true;
      
      // Only admins can write public assets
      allow write: if isAdmin();
    }

    // ==========================================
    // Catch-all: Deny everything else
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
